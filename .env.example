# ---------------------------------------------------------------------------
# SAIN MOTORS — MEGA TEST DRIVE 5
# Copy this file to `.env.local` and fill in the values. Never commit .env.local
# ---------------------------------------------------------------------------

# Google Apps Script Web App URL — the /exec URL you get after deploying
# docs/apps-script.gs from the registrations spreadsheet:
#  https://script.google.com/macros/s/AKfycbwmZlYf7MBPk9ZEYhYb_Je1K_Q7hEBmWvjzqDwCwHHtsRKSjdQwqECZh2W5WYwZpXki/exec
# Handles POST (append registration) and GET ?mode=counts (slot availability).
# Server-side only — never prefixed with NEXT_PUBLIC_.
GOOGLE_SHEETS_WEBHOOK_URL=

# Canonical site origin, used for metadata / Open Graph absolute URLs.
NEXT_PUBLIC_SITE_URL=https://megatestdrive.sainmotors.mn
